<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_root_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/island_pill_bg"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:elevation="14dp">

    <!-- COMPACT CAPSULE STATE -->
    <LinearLayout
        android:id="@+id/island_compact_container"
        android:layout_width="184dp"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/island_compact_art"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_album_placeholder" />

        <TextView
            android:id="@+id/island_compact_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.pulsemusic.player.island.SpectrumWaveView
            android:id="@+id/island_compact_spectrum"
            android:layout_width="26dp"
            android:layout_height="18dp" />
    </LinearLayout>

    <!-- EXPANDED CARD STATE -->
    <LinearLayout
        android:id="@+id/island_expanded_container"
        android:layout_width="344dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <!-- Header Row: Album Art + Track Info + Spectrum + Collapse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/island_expanded_art"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_album_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/island_expanded_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/island_expanded_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/unknown_artist"
                    android:textColor="#B8FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/island_expanded_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/island_subtitle"
                    android:textColor="#FF80D8FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.pulsemusic.player.island.SpectrumWaveView
                android:id="@+id/island_expanded_spectrum"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/island_btn_collapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_collapse"
                android:padding="4dp"
                android:src="@drawable/ic_widget_close" />
        </LinearLayout>

        <!-- Seek Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/island_time_elapsed"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/island_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="#FF00E5FF"
                android:thumbTint="#FFFFFFFF" />

            <TextView
                android:id="@+id/island_time_total"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0:00"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Transport Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/island_btn_favorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorite"
                android:src="@drawable/ic_widget_heart" />

            <ImageButton
                android:id="@+id/island_btn_prev"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_previous"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/island_btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_play_pause"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/island_btn_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/island_btn_open_app"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_open_app"
                android:src="@drawable/ic_widget_expand" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
